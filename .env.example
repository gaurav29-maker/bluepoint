# Postgres. Neon or Supabase both work; use the pooled connection string.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Razorpay. PHASE 1 USES TEST KEYS ONLY - they start rzp_test_.
# Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
# Dashboard > Settings > Webhooks. This is NOT the key secret.
RAZORPAY_WEBHOOK_SECRET=""
# Same value as RAZORPAY_KEY_ID; exposed to the browser for Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# Resend. In phase 1, point every address at your own inbox.
RESEND_API_KEY=""
EMAIL_FROM="Bluepoint <bookings@example.com>"
EMAIL_REPLY_TO="you@example.com"

# Signing secret for intake magic links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=""

# Guards the Vercel Cron endpoints.
CRON_SECRET=""

# The single password for the ops console at /ops. If this is unset the
# console refuses everyone, which is the safe default.
OPS_PASSWORD=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
